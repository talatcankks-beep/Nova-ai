# ====================================
# NOVA AI STUDIO - Environment Variables
# ====================================

# --- APPLICATION ---
APP_NAME=NovaAI
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

# --- SERVER ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- DATABASE ---
DATABASE_URL=postgresql://nova_user:nova_password@postgres:5432/nova_ai
DB_ECHO=true

# --- REDIS ---
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=1

# --- JWT ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- OAUTH (Optional) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# --- AI PROVIDERS ---

## OpenAI
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=optional-org-id

## Replicate
REPLICATE_API_TOKEN=r8_...

## Hugging Face
HUGGINGFACE_API_TOKEN=hf_...

## Alternative providers (when added)
# ANTHROPIC_API_KEY=...
# COHERE_API_KEY=...

# --- FILE STORAGE ---
STORAGE_TYPE=s3  # s3, minio, local
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=nova-ai-storage
AWS_S3_REGION=us-east-1

# For MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- SECURITY ---
NSFW_FILTER_ENABLED=true
NSFW_FILTER_THRESHOLD=0.7

# Content moderation
CONTENT_MODERATION_ENABLED=true
MODERATION_PROVIDER=openai  # openai, replicate, etc.

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- EMAIL (for notifications) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@novaai.studio

# --- MONITORING ---
SENTRY_DSN=optional-sentry-dsn
SENTRY_ENVIRONMENT=development

# --- FRONTEND ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Nova AI Studio

# --- DEVELOPMENT ---
# Set to true to use mock AI providers (for testing without API keys)
USE_MOCK_PROVIDERS=false

# ====================================
# PRODUCTION NOTES:
# 1. Change JWT_SECRET_KEY to a secure random value
# 2. Set DEBUG=false
# 3. Use strong database credentials
# 4. Set proper API keys for all providers
# 5. Configure S3 with proper credentials
# 6. Enable HTTPS
# 7. Set proper CORS origins
# ====================================
